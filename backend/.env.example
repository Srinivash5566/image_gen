# Optional overrides. Models downloaded in Settings are discovered automatically.
# Generation: Qwen/Qwen-Image (Diffusers directory, not a standalone GGUF).
QWEN_MODEL_PATH=
# Editing: Qwen/Qwen-Image-Edit (original single-image variant).
QWEN_EDIT_MODEL_PATH=
# auto picks CUDA, then MPS on Apple Silicon, otherwise CPU.
QWEN_DEVICE=auto